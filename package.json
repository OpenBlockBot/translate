{
  "name": "translate",
  "version": "1.0.0",
  "author": "OpenBlock",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/openblock-plugin/translate.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "npx openblock-registry-cli dev",
    "build": "npx openblock-registry-cli build",
    "build:obfuscate": "npx openblock-registry-cli build --obfuscate",
    "publish": "npx openblock-registry-cli publish",
    "publish:dry": "npx openblock-registry-cli publish --dry-run",
    "validate": "npx openblock-registry-cli validate",
    "i18n:update": "npx openblock-registry-cli i18n update",
    "lint": "eslint . --ext .js --fix"
  },
  "openblock": {
    "name": {
      "formatMessage": {
        "id": "translate.name",
        "default": "Translate"
      }
    },
    "extensionId": "translate",
    "arch": null,
    "iconURL": "./assets/translate.png",
    "description": {
      "formatMessage": {
        "id": "translate.description",
        "default": "Translate text into many languages."
      }
    },
    "internetConnectionRequired": true,
    "main": "./src/translate.js",
    "translations": "./src/translations.js",
    "tags": [
      "scratch"
    ],
    "helpLink": "https://wiki.openblock.cc"
  },
  "dependencies": {
    "scratch-translate-extension-languages": "0.0.20191118205314"
  },
  "devDependencies": {
    "eslint": "^5.3.0",
    "eslint-config-scratch": "^5.0.0",
    "husky": "^9.0.0"
  }
}
